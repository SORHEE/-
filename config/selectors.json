{
  "_comment": "네이버 블로그 스마트에디터 ONE의 UI는 수시로 바뀔 수 있습니다. 자동입력이 실패하면 이 파일의 selector 값만 갱신하면 됩니다(코드 수정 불필요). 값은 CSS selector 또는 'text=' 프리픽스를 쓰는 Playwright 텍스트 셀렉터를 사용할 수 있습니다.",

  "writePage": {
    "url": "https://blog.naver.com/{blogId}?Redirect=Write&",
    "iframeSelector": "#mainFrame",
    "titleArea": ".se-title-text .se-text-paragraph",
    "documentTitleFallback": ".se-documentTitle .se-text-paragraph",
    "helpCloseButton": "button.se-help-panel-close-button, .se-popup-button-cancel",
    "helperPopupCancel": ".se-popup-dim + .se-popup .se-popup-button-cancel"
  },

  "toolbar": {
    "imageButton": ".se-image-toolbar-button, button[data-name='image']",
    "fontSizeDropdown": ".se-font-size-code-toolbar-button, button[data-name='font-size']",
    "fontSize15pt": ".se-toolbar-option-font-size-code-fs15-button, button[data-value='fs15']",
    "quoteButton": "button[data-name='quotation']",
    "quoteTypeDefault": ".se-quotation-toolbar-panel .se-quotation-type-default"
  },

  "publish": {
    "openPublishLayerButton": "button.publish_btn_area button, .se-actionbar-area button:has-text('발행')",
    "openTypeRadioGroupName": "open_type",
    "openTypePrivateSelector": "#open_private",
    "openTypePublicSelector": "#open_public",
    "categorySelect": "#ContentsCategorySelect",
    "finalPublishButton": ".layer_publish button.button_publish, .publish_layer button[data-testid='publish-btn']",
    "publishedUrlIndicator": ".se-publish-complete-url, a.link_view"
  }
}
